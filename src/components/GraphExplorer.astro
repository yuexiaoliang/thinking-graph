---
import { RELATION_LABELS, thoughtPath, conversationPath } from "../../lib/thinking-graph.mjs";
import { categoryLabel, categoryColor, statusLabel } from "../lib/presentation.js";

const { model, listOnly = false } = Astro.props;
const { nodes, nodeMap } = model;
const children = new Map(nodes.map((node) => [node.id, []]));
for (const node of nodes) {
  if (node.primary_parent) children.get(node.primary_parent)?.push(node.id);
}
const roots = nodes.filter((node) => !node.primary_parent);
const positions = new Map();
let leafCursor = 0;
function place(id, depth) {
  const kids = children.get(id) || [];
  const xs = kids.map((child) => place(child, depth + 1));
  const x = xs.length ? (xs[0] + xs.at(-1)) / 2 : 116 + leafCursor++ * 216;
  positions.set(id, { x, y: 64 + depth * 94 });
  return x;
}
roots.forEach((root) => place(root.id, 0));
const graphWidth = Math.max(232, leafCursor * 216 + 16);
const graphHeight = Math.max(160, ...[...positions.values()].map((p) => p.y + 64));
function edgePath(source, target) {
  const a = positions.get(source);
  const b = positions.get(target);
  const mid = (a.y + b.y) / 2;
  return `M ${a.x} ${a.y + 34} C ${a.x} ${mid}, ${b.x} ${mid}, ${b.x} ${b.y - 34}`;
}
function titleLines(title) {
  const lines = [""];
  let width = 0;
  for (const char of title) {
    const size = /[\x00-\x7F]/.test(char) ? 0.55 : 1;
    if (width + size > 10) {
      if (lines.length === 2) { lines[1] += "…"; break; }
      lines.push(""); width = 0;
    }
    lines[lines.length - 1] += char;
    width += size;
  }
  return lines;
}
const categories = [...new Set(nodes.map((node) => node.category))];
const primaryEdges = nodes.filter((node) => node.primary_parent).map((node) => ({
  source: node.primary_parent, target: node.id
}));
const crossEdges = model.graph.edges.filter((edge) => edge.type !== "forked_from");
const incomingLabels = {
  related_to: "相关", supports: "得到支持", contradicts: "矛盾",
  refines: "被修正", leads_to: "由此引出", depends_on: "被依赖"
};
const clientNodes = nodes.map((node) => ({
  id: node.id, title: node.title, summary: node.summary, category: node.category,
  categoryLabel: categoryLabel(node.category), color: categoryColor(node.category),
  url: thoughtPath(node.id), ...positions.get(node.id),
  parent: node.primary_parent ? {
    title: nodeMap.get(node.primary_parent).title, url: thoughtPath(node.primary_parent)
  } : null,
  children: children.get(node.id).map((id) => ({ title: nodeMap.get(id).title, url: thoughtPath(id) })),
  relations: crossEdges.filter((edge) => edge.source === node.id || edge.target === node.id).map((edge) => {
    const outgoing = edge.source === node.id;
    const otherId = outgoing ? edge.target : edge.source;
    return {
      title: nodeMap.get(otherId).title, url: thoughtPath(otherId),
      label: (outgoing ? RELATION_LABELS[edge.type] : incomingLabels[edge.type]) || edge.type, reason: edge.reason
    };
  }),
  conversations: (node.source_conversations || []).map((id) => ({
    title: model.conversationMap.get(id).title, url: conversationPath(id)
  }))
}));
const payload = JSON.stringify(clientNodes).replace(/</g, "\\u003c");
---

<section class:list={["explorer", { "catalog-only": listOnly }]} data-thinking-graph data-list-only={String(listOnly)} aria-label={listOnly ? "浏览思想节点" : "探索思想图谱"}>
  <div class="explorer-heading">
    <div class="explorer-title"><h2>{listOnly ? "全部节点" : "思想图谱"}</h2><span class="result-count" data-result-count aria-live="polite" aria-atomic="true">{nodes.length} 个节点</span></div>
    {!listOnly && <div class="view-switch" role="group" aria-label="浏览方式" data-enhanced hidden>
      <button type="button" data-view="graph" aria-pressed="false" aria-controls="graph-view">图谱</button>
      <button type="button" data-view="list" aria-pressed="true" aria-controls="list-view">列表</button>
    </div>}
  </div>

  <div class="explorer-toolbar" data-enhanced hidden>
    <div class="search-field">
      <label class="sr-only" for="node-search">搜索思想节点</label>
      <input id="node-search" type="search" placeholder="搜索标题、摘要或标签…" autocomplete="off" data-graph-search />
      <kbd class="search-shortcut" aria-hidden="true">/</kbd>
    </div>
    <label class="category-field"><span class="sr-only">按类别筛选</span><select data-graph-category>
      <option value="all">全部主题</option>
      {categories.map((category) => <option value={category}>{categoryLabel(category)}</option>)}
    </select></label>
    <button class="text-button filter-reset" type="button" data-clear-filters hidden>清除筛选</button>
  </div>

  <div class="empty-state panel" data-empty-state hidden>
    <h3>没有找到匹配的节点</h3>
    <p>试试更短的关键词，或清除主题筛选。</p>
    <button class="button" type="button" data-clear-filters>查看全部节点</button>
  </div>

  <div class="thought-grid" id="list-view" data-list-view>
    {nodes.map((node, index) => <a class="thought-card" href={thoughtPath(node.id)} data-node-card data-id={node.id} data-category={node.category} data-search={[node.title, node.summary, ...node.tags].join(" ").toLowerCase()} style={"--category-color:" + categoryColor(node.category)}>
      <div class="card-top"><span class="category-label">{categoryLabel(node.category)}</span><span class="card-number">{String(index + 1).padStart(2, "0")}</span></div>
      <h3>{node.title}</h3>
      <p>{node.summary}</p>
      <div class="card-bottom"><span>{statusLabel(node.status)}</span><span class="card-read">阅读节点 <span aria-hidden="true">↗</span></span></div>
    </a>)}
  </div>

  {!listOnly && <div class="graph-workspace panel" id="graph-view" data-graph-view hidden>
    <div class="graph-canvas">
      <div class="canvas-toolbar">
        <label class="graph-toggle"><input type="checkbox" checked data-graph-cross-toggle />跨话题关系</label>
        <button class="text-button touch-pan-toggle" type="button" aria-pressed="false" data-touch-pan>移动画布</button>
        <span class="canvas-tip">拖动平移 · Ctrl / ⌘ + 滚轮缩放</span>
      </div>
      <div class="graph-stage" data-graph-stage>
        <svg viewBox={`0 0 ${graphWidth} ${graphHeight}`} role="group" aria-label="交互思想图谱" aria-describedby="graph-instructions" tabindex="0" data-graph-svg>
          <g data-graph-viewport>
            <g aria-hidden="true">{primaryEdges.map((edge) => <path class="graph-primary-edge graph-edge" d={edgePath(edge.source, edge.target)} data-source={edge.source} data-target={edge.target} />)}</g>
            <g class="graph-cross-layer" data-graph-cross-layer aria-hidden="true">{crossEdges.map((edge) => <path class="graph-cross-edge graph-edge" d={edgePath(edge.source, edge.target)} data-source={edge.source} data-target={edge.target} />)}</g>
            <g>{nodes.map((node) => {
              const pos = positions.get(node.id);
              const lines = titleLines(node.title);
              return <a href={thoughtPath(node.id)} class="graph-node" data-graph-node data-id={node.id} aria-label={"预览：" + node.title} transform={`translate(${pos.x},${pos.y})`} style={"--category-color:" + categoryColor(node.category)}>
                <title>{node.title}</title>
                <rect x="-96" y="-34" width="192" height="68" rx="10" />
                <circle cx="-81" cy="-19" r="3.5" />
                <text class="node-title">{lines.map((line, i) => <tspan x="0" y={lines.length === 1 ? 0 : -9 + i * 18}>{line}</tspan>)}</text>
                <text class="node-category" x="0" y="25">{categoryLabel(node.category)}</text>
              </a>;
            })}</g>
          </g>
        </svg>
        <div class="zoom-controls" role="group" aria-label="画布缩放">
          <button type="button" aria-label="缩小图谱" data-graph-zoom-out>−</button>
          <output data-zoom-level aria-label="缩放比例">100%</output>
          <button type="button" aria-label="放大图谱" data-graph-zoom-in>+</button>
          <button type="button" data-graph-fit>适应画布</button>
        </div>
      </div>
      <div class="graph-legend"><span><i class="line-sample" aria-hidden="true"></i>主分支</span><span><i class="line-sample cross" aria-hidden="true"></i>跨话题</span><span class="legend-hint">选择节点，查看来路与分支</span></div>
      <p class="sr-only" id="graph-instructions">Tab 切换节点，Enter 预览。方向键移动画布，加减键缩放，0 恢复全貌。手机上可启用移动画布，再拖动或双指缩放；再次关闭即可滚动页面。</p>
    </div>
    <aside class="graph-detail" aria-label="节点预览" data-graph-detail>
      <div class="detail-placeholder"><span class="eyebrow">从这里开始</span><h3>选择一个思想节点</h3><p>查看当前理解、思考来路和可以继续探索的分支。</p><a href="/thoughts/">浏览全部节点 <span aria-hidden="true">↗</span></a></div>
    </aside>
  </div>}

  {!listOnly && <dialog class="node-dialog" aria-labelledby="dialog-node-title" data-node-dialog>
    <div class="dialog-header"><span>节点预览</span><button class="button" type="button" data-close-dialog autofocus>关闭</button></div>
    <div data-dialog-content></div>
  </dialog>}
  <p class="sr-only" data-selection-status role="status"></p>
  <noscript><p class="empty-note">可直接阅读上方节点；启用 JavaScript 后可使用筛选与交互图谱。</p></noscript>
  <script type="application/json" data-graph-data is:inline set:html={payload}></script>
</section>

<script>
  import { initExplorer } from "../scripts/graph-explorer.js";
  document.querySelectorAll("[data-thinking-graph]").forEach(initExplorer);
</script>
