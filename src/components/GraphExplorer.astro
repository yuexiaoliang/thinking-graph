---
import {
  RELATION_LABELS,
  thoughtPath,
  conversationPath
} from "../../lib/thinking-graph.mjs";

const { model } = Astro.props;
const nodes = model.nodes;
const nodeMap = model.nodeMap;

const children = new Map(nodes.map((node) => [node.id, []]));
for (const node of nodes) {
  if (node.primary_parent && children.has(node.primary_parent)) {
    children.get(node.primary_parent).push(node.id);
  }
}

const roots = nodes.filter(
  (node) => !node.primary_parent || !nodeMap.has(node.primary_parent)
);

const leafGap = 205;
const top = 90;
const levelGap = 155;
let leafCursor = 0;
const positions = new Map();

function place(id, depth) {
  const kids = children.get(id) || [];
  if (!kids.length) {
    const x = 115 + leafCursor * leafGap;
    leafCursor += 1;
    positions.set(id, { x, y: top + depth * levelGap, depth });
    return x;
  }

  const xs = kids.map((childId) => place(childId, depth + 1));
  const x = xs.reduce((sum, value) => sum + value, 0) / xs.length;
  positions.set(id, { x, y: top + depth * levelGap, depth });
  return x;
}

roots.forEach((root, index) => {
  if (index > 0) leafCursor += 1;
  place(root.id, 0);
});

const maxDepth = Math.max(0, ...Array.from(positions.values()).map((position) => position.depth));
const graphWidth = Math.max(1400, 250 + Math.max(1, leafCursor - 1) * leafGap);
const graphHeight = Math.max(820, 210 + maxDepth * levelGap);

function edgePath(a, b) {
  const dy = b.y - a.y;
  const curve = Math.max(40, Math.abs(dy) * 0.45);
  return (
    "M " +
    a.x +
    " " +
    (a.y + 30) +
    " C " +
    a.x +
    " " +
    (a.y + curve) +
    ", " +
    b.x +
    " " +
    (b.y - curve) +
    ", " +
    b.x +
    " " +
    (b.y - 30)
  );
}

const primaryEdges = nodes
  .filter((node) => node.primary_parent)
  .map((node) => ({
    source: node.primary_parent,
    target: node.id,
    d: edgePath(positions.get(node.primary_parent), positions.get(node.id))
  }));

const crossEdges = model.graph.edges
  .filter((edge) => edge.type !== "forked_from")
  .map((edge) => ({
    ...edge,
    d: edgePath(positions.get(edge.source), positions.get(edge.target))
  }));

const categories = Array.from(new Set(nodes.map((node) => node.category))).sort();

const clientNodes = nodes.map((node) => {
  const relations = model.graph.edges
    .filter(
      (edge) =>
        edge.type !== "forked_from" &&
        (edge.source === node.id || edge.target === node.id)
    )
    .map((edge) => {
      const outgoing = edge.source === node.id;
      const otherId = outgoing ? edge.target : edge.source;
      const other = nodeMap.get(otherId);
      return {
        type: edge.type,
        label: RELATION_LABELS[edge.type] || edge.type,
        direction: outgoing ? "outgoing" : "incoming",
        id: otherId,
        title: other?.title || otherId,
        reason: edge.reason
      };
    });

  const sourceConversations = (node.source_conversations || [])
    .map((id) => model.conversationMap.get(id))
    .filter(Boolean)
    .map((conversation) => ({
      id: conversation.id,
      title: conversation.title
    }));

  return {
    id: node.id,
    title: node.title,
    summary: node.summary,
    category: node.category,
    url: thoughtPath(node.id),
    parent: node.primary_parent
      ? {
          id: node.primary_parent,
          title: nodeMap.get(node.primary_parent)?.title || node.primary_parent,
          url: thoughtPath(node.primary_parent)
        }
      : null,
    relations,
    conversations: sourceConversations.map((conversation) => ({
      ...conversation,
      url: conversationPath(conversation.id)
    }))
  };
});

const clientPayload = JSON.stringify(clientNodes).replace(/</g, "\\u003c");
---

<section class="panel graph-shell" data-thinking-graph>
  <div class="graph-controls">
    <input
      type="search"
      placeholder="搜索节点标题或摘要…"
      aria-label="搜索思想节点"
      data-graph-search
    />
    <div class="graph-actions">
      <select aria-label="按类别筛选" data-graph-category>
        <option value="all">全部类别</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
      <label class="graph-toggle">
        <input type="checkbox" checked data-graph-cross-toggle />
        跨话题
      </label>
      <button type="button" aria-label="放大" data-graph-zoom-in>＋</button>
      <button type="button" aria-label="缩小" data-graph-zoom-out>−</button>
      <button type="button" data-graph-reset>重置</button>
    </div>
  </div>

  <div class="graph-stage" data-graph-stage>
    <svg
      viewBox={"0 0 " + graphWidth + " " + graphHeight}
      role="img"
      aria-label="Thinking Graph 交互思想图谱"
      data-graph-svg
    >
      <g data-graph-viewport>
        <g>
          {
            primaryEdges.map((edge) => (
              <path
                class="graph-primary-edge graph-edge"
                d={edge.d}
                data-source={edge.source}
                data-target={edge.target}
              />
            ))
          }
        </g>

        <g class="graph-cross-layer" data-graph-cross-layer>
          {
            crossEdges.map((edge) => (
              <path
                class="graph-cross-edge graph-edge"
                d={edge.d}
                data-source={edge.source}
                data-target={edge.target}
              />
            ))
          }
        </g>

        <g>
          {
            nodes.map((node) => {
              const position = positions.get(node.id);
              const shortTitle =
                node.title.length > 16 ? node.title.slice(0, 15) + "…" : node.title;

              return (
                <a
                  href={thoughtPath(node.id)}
                  class="graph-node"
                  data-graph-node
                  data-id={node.id}
                  data-category={node.category}
                  data-search={(node.title + " " + (node.summary || "")).toLowerCase()}
                  transform={"translate(" + position.x + "," + position.y + ")"}
                >
                  <rect x="-88" y="-30" width="176" height="60" rx="13" />
                  <circle
                    cx="-72"
                    cy="-15"
                    r="5"
                    fill={
                      node.category === "talent"
                        ? "var(--talent)"
                        : node.category === "employment"
                          ? "var(--employment)"
                          : node.category === "data"
                            ? "var(--data)"
                            : node.category === "creator-economy"
                              ? "var(--creator)"
                              : node.category === "meta"
                                ? "var(--meta)"
                                : "var(--future)"
                    }
                  />
                  <text class="node-title" x="0" y="4">{shortTitle}</text>
                  <text x="0" y="22" font-size="10" fill="var(--muted)">
                    {node.category}
                  </text>
                </a>
              );
            })
          }
        </g>
      </g>
    </svg>
  </div>

  <div class="graph-legend">
    <span>实线：主父分叉</span>
    <span>虚线：跨话题关系</span>
    <span>点击节点预览；“打开完整节点”进入静态页面</span>
  </div>

  <aside class="panel graph-detail" data-graph-detail aria-live="polite">
    <button
      class="graph-detail-close"
      type="button"
      aria-label="关闭节点预览"
      data-graph-detail-close
    >
      ×
    </button>
    <h2>选择一个思想节点</h2>
    <p>节点详情会在这里预览。所有节点同时拥有真实静态 URL，可独立阅读、分享和引用。</p>
  </aside>

  <script type="application/json" data-graph-data is:inline set:html={clientPayload}></script>
</section>

<script>
  for (const root of document.querySelectorAll("[data-thinking-graph]")) {
    const dataElement = root.querySelector("[data-graph-data]");
    const nodes = JSON.parse(dataElement?.textContent || "[]");
    const nodeMap = new Map(nodes.map((node) => [node.id, node]));

    const search = root.querySelector("[data-graph-search]");
    const category = root.querySelector("[data-graph-category]");
    const crossToggle = root.querySelector("[data-graph-cross-toggle]");
    const crossLayer = root.querySelector("[data-graph-cross-layer]");
    const detail = root.querySelector("[data-graph-detail]");
    const svg = root.querySelector("[data-graph-svg]");
    const viewport = root.querySelector("[data-graph-viewport]");
    const stage = root.querySelector("[data-graph-stage]");

    let selectedId = null;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let pointer = null;

    const isMobile = () => window.matchMedia("(max-width: 860px)").matches;

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function applyTransform() {
      viewport?.setAttribute(
        "transform",
        "translate(" + tx + " " + ty + ") scale(" + scale + ")"
      );
    }

    function renderFilters() {
      const query = String(search?.value || "").trim().toLowerCase();
      const selectedCategory = String(category?.value || "all");
      const visible = new Set();

      root.querySelectorAll("[data-graph-node]").forEach((element) => {
        const categoryMatches =
          selectedCategory === "all" || element.dataset.category === selectedCategory;
        const queryMatches =
          !query || String(element.dataset.search || "").includes(query);
        const show = categoryMatches && queryMatches;

        element.classList.toggle("dimmed", !show);
        element.classList.toggle("search-match", Boolean(query && queryMatches));
        if (show) visible.add(element.dataset.id);
      });

      root.querySelectorAll(".graph-edge").forEach((edge) => {
        const show =
          visible.has(edge.dataset.source) && visible.has(edge.dataset.target);
        edge.classList.toggle("dimmed", !show);
      });

      crossLayer?.classList.toggle("hidden", !crossToggle?.checked);
    }

    function renderDetail(id) {
      const node = nodeMap.get(id);
      if (!node || !detail) return;

      selectedId = id;
      root.querySelectorAll("[data-graph-node]").forEach((element) => {
        element.classList.toggle("selected", element.dataset.id === id);
      });

      const relationLinks = node.relations
        .slice(0, 6)
        .map(
          (relation) =>
            '<a href="/thoughts/' +
            encodeURIComponent(relation.id) +
            '/">' +
            escapeHtml(relation.label + " · " + relation.title) +
            "</a>"
        )
        .join("");

      const sourceLinks = node.conversations
        .slice(0, 3)
        .map(
          (conversation) =>
            '<a href="' +
            escapeHtml(conversation.url) +
            '">' +
            escapeHtml("来源 · " + conversation.title) +
            "</a>"
        )
        .join("");

      detail.innerHTML =
        '<button class="graph-detail-close" type="button" aria-label="关闭节点预览" data-graph-detail-close>×</button>' +
        "<h2>" +
        escapeHtml(node.title) +
        "</h2>" +
        "<p>" +
        escapeHtml(node.summary || "") +
        "</p>" +
        '<div class="graph-detail-links">' +
        '<a href="' +
        escapeHtml(node.url) +
        '">打开完整节点</a>' +
        relationLinks +
        sourceLinks +
        "</div>";

      detail.querySelector("[data-graph-detail-close]")?.addEventListener("click", () => {
        detail.classList.remove("open");
      });

      if (isMobile()) detail.classList.add("open");
    }

    root.querySelectorAll("[data-graph-node]").forEach((element) => {
      element.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        renderDetail(element.dataset.id);
      });
    });

    search?.addEventListener("input", renderFilters);
    category?.addEventListener("change", renderFilters);
    crossToggle?.addEventListener("change", renderFilters);

    root.querySelector("[data-graph-zoom-in]")?.addEventListener("click", () => {
      scale = Math.min(2.8, scale * 1.18);
      applyTransform();
    });

    root.querySelector("[data-graph-zoom-out]")?.addEventListener("click", () => {
      scale = Math.max(0.35, scale * 0.85);
      applyTransform();
    });

    root.querySelector("[data-graph-reset]")?.addEventListener("click", () => {
      scale = 1;
      tx = 0;
      ty = 0;
      applyTransform();
    });

    svg?.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        scale = Math.max(0.35, Math.min(2.8, scale * (event.deltaY < 0 ? 1.1 : 0.9)));
        applyTransform();
      },
      { passive: false }
    );

    svg?.addEventListener("pointerdown", (event) => {
      if (event.target.closest?.("[data-graph-node]")) return;
      pointer = {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY,
        tx,
        ty
      };
      svg.setPointerCapture(event.pointerId);
    });

    svg?.addEventListener("pointermove", (event) => {
      if (!pointer || pointer.id !== event.pointerId || !stage) return;
      const rect = stage.getBoundingClientRect();
      const viewBox = svg.viewBox.baseVal;
      tx = pointer.tx + (event.clientX - pointer.x) * (viewBox.width / rect.width);
      ty = pointer.ty + (event.clientY - pointer.y) * (viewBox.height / rect.height);
      applyTransform();
    });

    const releasePointer = (event) => {
      if (!pointer || pointer.id !== event.pointerId) return;
      pointer = null;
      try {
        svg?.releasePointerCapture(event.pointerId);
      } catch {}
    };

    svg?.addEventListener("pointerup", releasePointer);
    svg?.addEventListener("pointercancel", releasePointer);

    svg?.addEventListener("click", (event) => {
      if (!event.target.closest?.("[data-graph-node]") && isMobile()) {
        detail?.classList.remove("open");
      }
    });

    root.querySelector("[data-graph-detail-close]")?.addEventListener("click", () => {
      detail?.classList.remove("open");
    });

    renderFilters();
  }
</script>
