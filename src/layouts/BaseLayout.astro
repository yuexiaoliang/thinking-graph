---
import "../styles/global.css";

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  robots = "index,follow",
  ogType = "website",
  jsonLd = [],
  graphCategories = []
} = Astro.props;

const fullTitle = title === "Thinking Graph" ? title : title + " | Thinking Graph";
const canonical = Astro.site ? new URL(canonicalPath, Astro.site).toString() : null;
const structuredData = Array.isArray(jsonLd) ? jsonLd.filter(Boolean) : [jsonLd].filter(Boolean);
const isHome = Astro.url.pathname === "/";
const isThought = Astro.url.pathname.startsWith("/thoughts/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Thinking Graph for AI agents" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("thinking-graph-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    {
      structuredData.map((data) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(data)}></script>
      ))
    }
  </head>
  <body class:list={{ "home-page": isHome }}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="主导航">
        <a class="site-brand" href="/" aria-label="Thinking Graph"><span class="brand-full">Thinking<span>Graph</span><span class="brand-dot" aria-hidden="true">.</span></span><span class="brand-short" aria-hidden="true">TG<span class="brand-dot">.</span></span></a>
        {isHome && <div class="site-search" data-header-search data-open="false" hidden>
          <button class="search-trigger" type="button" data-search-trigger aria-controls="home-search-fields" aria-expanded="false" aria-label="展开搜索与筛选">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.2" /><path d="m16 16 4.5 4.5" /></svg>
          </button>
          <div class="site-search-fields" id="home-search-fields">
            <label class="sr-only" for="node-search">搜索思想节点</label>
            <input id="node-search" type="search" placeholder="搜索节点…" autocomplete="off" data-graph-search />
            <label class="category-field"><span class="sr-only">按类别筛选</span><select data-graph-category>
              <option value="all">全部类别</option>
              {graphCategories.map((category) => <option value={category.value}>{category.label}</option>)}
            </select></label>
            <button class="search-close" type="button" data-search-close aria-label="收起搜索">×</button>
          </div>
          <button class="search-reset" type="button" data-clear-filters data-filter-reset hidden>清除筛选</button>
        </div>}
        <div class="site-links">
          <a href="/" aria-current={isHome ? "page" : undefined}>图谱</a>
          <a href="/thoughts/" aria-current={isThought ? "page" : undefined}>节点</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换显示主题" hidden>主题</button>
        </div>
      </nav>
    </header>

    <main class="site-main" id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <span>Thinking Graph <span class="footer-divider">/</span> 思考持续生长</span>
      <nav class="footer-links" aria-label="辅助导航">
        <a href="/llms.txt">AI 索引 <span aria-hidden="true">↗</span></a>
        {Astro.site && <a href="/sitemap-index.xml">Sitemap <span aria-hidden="true">↗</span></a>}
      </nav>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const preference = window.matchMedia("(prefers-color-scheme: dark)");
      const currentTheme = () => document.documentElement.dataset.theme || (preference.matches ? "dark" : "light");
      function updateThemeButton() {
        if (!toggle) return;
        const dark = currentTheme() === "dark";
        toggle.hidden = false;
        toggle.textContent = dark ? "浅色" : "深色";
        toggle.setAttribute("aria-label", dark ? "切换到浅色主题" : "切换到深色主题");
      }
      toggle?.addEventListener("click", () => {
        const theme = currentTheme() === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem("thinking-graph-theme", theme); } catch {}
        updateThemeButton();
      });
      preference.addEventListener("change", updateThemeButton);
      updateThemeButton();
    </script>
  </body>
</html>
