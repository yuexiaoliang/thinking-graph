---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadThinkingGraph } from "../../../lib/thinking-graph.mjs";
import GraphExplorer from "../../components/GraphExplorer.astro";

const model = await loadThinkingGraph();
const description = "Thinking Graph 中可独立继续、引用和追溯的思想节点。";
---

<BaseLayout
  title="思想节点"
  description={description}
  canonicalPath="/thoughts/"
>
  <nav class="breadcrumb" aria-label="面包屑">
    <a href="/">Thinking Graph</a>
    <span>›</span>
    <span>思想节点</span>
  </nav>

  <section class="hero">
    <span class="eyebrow">节点索引</span>
    <h1>思想节点</h1>
    <p>找到一个问题，沿着已有思考继续。</p>
  </section>

  <GraphExplorer model={model} listOnly />
</BaseLayout>
