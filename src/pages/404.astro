---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404"
  description="页面不存在。"
  canonicalPath="/404/"
  robots="noindex,nofollow"
>
  <section class="panel article-card error-page">
    <span class="eyebrow">404 · 路径不存在</span>
    <h1 class="page-title">这个分支还没有展开。</h1>
    <p class="page-summary">回到图谱，或从节点列表重新找到你想读的内容。</p>
    <div class="error-actions"><a class="button primary-button" href="/">返回图谱</a><a class="button" href="/thoughts/">浏览节点</a></div>
  </section>
</BaseLayout>
