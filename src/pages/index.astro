---
import BaseLayout from "../layouts/BaseLayout.astro";
import GraphExplorer from "../components/GraphExplorer.astro";
import { loadThinkingGraph } from "../../lib/thinking-graph.mjs";

const model = await loadThinkingGraph();
const description =
  "可追溯、可分叉、可被任意 AI Agent 继续的高信噪比思想图谱。";

const jsonLd = Astro.site
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).toString(),
      name: "Thinking Graph",
      description,
      url: new URL("/", Astro.site).toString()
    }
  : null;
---

<BaseLayout
  title="Thinking Graph"
  description={description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hero home-hero">
    <div>
      <span class="eyebrow">想法 · 连接 · 演化</span>
      <h1>探索思想之间的联系<span class="accent-text">。</span></h1>
      <p>从一个节点开始，追溯来路，找到下一步值得思考的问题。</p>
    </div>
    <div class="stats" aria-label="图谱统计">
      <div class="stat"><strong>{model.nodes.length}</strong><span>思想节点</span></div>
      <div class="stat"><strong>{model.graph.edges.length}</strong><span>关系连接</span></div>
      <div class="stat"><strong>{model.conversations.length}</strong><span>来源对话</span></div>
    </div>
  </section>

  <GraphExplorer model={model} />
</BaseLayout>
