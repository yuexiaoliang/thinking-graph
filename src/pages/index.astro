---
import BaseLayout from "../layouts/BaseLayout.astro";
import GraphExplorer from "../components/GraphExplorer.astro";
import { loadThinkingGraph } from "../../lib/thinking-graph.mjs";
import { categoryLabel } from "../lib/presentation.js";

const model = await loadThinkingGraph();
const graphCategories = [...new Set(model.nodes.map((node) => node.category))].map((value) => ({ value, label: categoryLabel(value) }));
const description =
  "可追溯、可分叉、可被任意 AI Agent 继续的高信噪比思想图谱。";

const jsonLd = Astro.site
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).toString(),
      name: "Thinking Graph",
      description,
      url: new URL("/", Astro.site).toString()
    }
  : null;
---

<BaseLayout
  title="Thinking Graph"
  description={description}
  canonicalPath="/"
  jsonLd={jsonLd}
  graphCategories={graphCategories}
>
  <h1 class="sr-only">思想图谱</h1>
  <GraphExplorer model={model} />
</BaseLayout>
